# Copy to .env for local development. Production must not use a .env file;
# settings come from the environment (docs/08-operability.md). Every key is
# documented in docs/08-operability.md "Settings".

XCODE_ENV=development                     # development | testing | production
XCODE_DATABASE_URL=postgresql://xcode_app:xcode_app@localhost:5432/xcode?sslmode=disable
XCODE_MIGRATION_DATABASE_URL=postgresql://xcode_owner:xcode_owner@localhost:5432/xcode?sslmode=disable
XCODE_DATABASE_OPERATOR_URL=postgresql://xcode_operator:xcode_operator@localhost:5432/xcode?sslmode=disable
XCODE_DATABASE_POOL_MIN=2
XCODE_DATABASE_POOL_MAX=10
XCODE_DATABASE_ALLOW_REQUIRE_SSLMODE=false  # permit sslmode=require instead of verify-full (logged)

XCODE_AUTH_SIGNING_KEY=                   # >= 32 random bytes; generated per process in development/testing when empty
XCODE_AUTH_PREVIOUS_SIGNING_KEYS=         # comma-separated verify-only keys during a rotation
XCODE_AUTH_ISSUER=xcode-api
XCODE_AUTH_AUDIENCE=xcode-clients
XCODE_AUTH_TRUST_LIFETIME_DAYS=           # empty = devices stay trusted until revoked
XCODE_AUTH_PIN_ITERATIONS=210000          # must equal the .NET value until all hashes are upgraded

XCODE_CORS_ORIGINS=http://localhost:3000  # comma-separated allow-list
XCODE_ALLOWED_HOSTS=*                     # comma-separated; production must list real hosts
XCODE_TRUSTED_PROXIES=127.0.0.1,::1       # X-Forwarded-For is believed only from these addresses

XCODE_RATE_LIMIT_BACKEND=memory           # memory | postgres (postgres when running more than one replica)
XCODE_RATE_LIMIT_AUTH_PER_MINUTE=30
XCODE_RATE_LIMIT_PIN_PER_ADDRESS=20       # PIN checks per client address in 10 minutes
XCODE_RATE_LIMIT_PIN_PER_DEVICE=10        # PIN checks per deviceId in 10 minutes

XCODE_MAIL_BACKEND=log                    # log (development/testing only) | smtp
XCODE_EMAIL_HOST=
XCODE_EMAIL_PORT=587
XCODE_EMAIL_FROM=
XCODE_EMAIL_USERNAME=
XCODE_EMAIL_PASSWORD=
XCODE_EMAIL_TIMEOUT_SECONDS=10            # positive; bounds the new-device mail sent before the reply
XCODE_EMAIL_TLS=true                      # false only for a relay on this machine (localhost, loopback) or in development

XCODE_LOG_FORMAT=console                  # console | json (json is forced in production)
XCODE_LOG_LEVEL=INFO
XCODE_DEVELOPMENT_CODES=false             # development only; return verification codes in responses
XCODE_DEMO_SEED=false                     # development only; refused in any other XCODE_ENV
XCODE_AUTO_MIGRATE=false                  # development only; migrate at startup
XCODE_OPENAPI_ENABLED=                    # empty = on in development/testing, off in production
XCODE_METRICS_ENABLED=false               # exposes /metrics (Prometheus text)
XCODE_SHUTDOWN_GRACE_SECONDS=10           # mail queue drain budget
XCODE_OPERATOR=                           # name recorded for CLI actions; defaults to the OS user name
